{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kosuke-starter",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Better Auth uses AsyncLocalStorage, which workerd provides under nodejs_compat.
  // This is a runtime flag, not permission to use Node or Bun APIs in server code.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // The database is Turso: TURSO_DATABASE_URL and TURSO_AUTH_TOKEN are Worker
  // secrets set by Kosuke, not bindings. See README.md.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  }
}
