# Local secrets for `bun run dev`. `bun install` copies this to .dev.vars
# with a random BETTER_AUTH_SECRET when .dev.vars does not exist.
BETTER_AUTH_SECRET=change-me

# The app's Turso database. Leave both unset to use the local file
# .data/local.db instead. They can also come from the environment.
# TURSO_DATABASE_URL=libsql://<database>-<org>.turso.io
# TURSO_AUTH_TOKEN=
