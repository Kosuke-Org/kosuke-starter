{
  "name": "kosuke-starter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "bun scripts/setup-dev-vars.ts",
    "dev": "bun run db:migrate && vite",
    "build": "vite build",
    "preview": "bun run build && vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:remote": "DB_REQUIRE_REMOTE=1 drizzle-kit migrate",
    "deploy": "bun run build && bun run db:migrate:remote && wrangler deploy",
    "cf-typegen": "wrangler types --include-runtime false"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "lucide-react": "1.54.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "@cloudflare/workers-types": "5.20261009.1",
    "@eslint/js": "10.0.1",
    "@fontsource-variable/geist": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.42",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "libsql": "0.5.29",
    "shadcn": "4.21.4",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22"
  }
}
